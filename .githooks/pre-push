#!/bin/sh
# Local gate before anything reaches GitHub (enable once per clone with:
#   git config core.hooksPath .githooks).
# On main: no force-pushes, every new commit signed by a trusted key, and the
# build-stage security guard green. Other branches: no secrets in what's pushed.
z40=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue # deleting a branch
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$remote_sha" != "$z40" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: this would rewrite main's history (force-push). Refused."; exit 1
    fi
    sh deploy/verify-commits.sh "$local_sha" || { echo "pre-push: main must contain only commits signed by a trusted key."; exit 1; }
    node --test test/build-security.test.mjs >/dev/null 2>&1 || { echo "pre-push: the build-stage security guard fails: node --test test/build-security.test.mjs"; exit 1; }
  fi
done
exit 0

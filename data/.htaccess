# Only these catalog scripts are intentionally public. Data files containing
# internal playbooks, client-learning rules, or team information stay private.
<FilesMatch "^(?!catalog\.js$|playbooks\.js$|community\.js$).+">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

{"level":"basic","title":"Using Bitcoin","questions":[{"id":"L2-001","level":"basic","q":"What do bech32 addresses start with?","choices":["1...","3...","bc1...","xpub..."],"answer":2,"source":"BIP-173"},{"id":"L2-002","level":"basic","q":"What is SegWit?","choices":["an upgrade that fixed malleability and raised capacity","a new coin","a wallet brand","a mining pool"],"answer":0,"source":"BIP-141"},{"id":"L2-003","level":"basic","q":"What is Taproot?","choices":["a Lightning wallet","an upgrade adding Schnorr signatures and smarter contracts","a block explorer","a mining chip"],"answer":1,"source":"BIP-340, BIP-341"},{"id":"L2-004","level":"basic","q":"What is RBF?","choices":["a wallet backup","a miner reward","a block type","replacing a stuck transaction with a higher fee"],"answer":3,"source":"BIP-125"},{"id":"L2-005","level":"basic","q":"What is CPFP?","choices":["a mining pool","spending an unconfirmed output with a fee to confirm both","closing a channel","splitting a wallet"],"answer":1,"source":"bitcoin.org developer docs, transactions"},{"id":"L2-006","level":"basic","q":"What is a UTXO?","choices":["an unspent output: a spendable coin","a miner's tool","a wallet password","a block hash"],"answer":0,"source":"bitcoin.org developer docs, transactions"},{"id":"L2-007","level":"basic","q":"What is change in a Bitcoin payment?","choices":["a new coin","a miner fee","leftover sent back to yourself","lost money"],"answer":2,"source":"bitcoin.org developer docs, transactions"},{"id":"L2-008","level":"basic","q":"What is dust?","choices":["old wallets","a tiny output worth less than its fee","a broken block","spam email"],"answer":1,"source":"bitcoin.org developer docs, transactions"},{"id":"L2-009","level":"basic","q":"What is the mempool?","choices":["a mining pool","a wallet folder","a block archive","a waiting area for unconfirmed transactions"],"answer":3,"source":"bitcoin.org developer docs, peer-to-peer"},{"id":"L2-010","level":"basic","q":"What does a stuck transaction usually mean?","choices":["its fee is too low for current demand","it is too big to fit","miners rejected bitcoin","the wallet is offline"],"answer":0,"source":"bitcoin.org, FAQ"},{"id":"L2-011","level":"basic","q":"What is a block explorer?","choices":["a mining program","a wallet app","a website to look up transactions and blocks","a hardware device"],"answer":2,"source":"bitcoin.org, resources"},{"id":"L2-012","level":"basic","q":"What is double spending?","choices":["paying twice by mistake","trying to spend the same coin twice","mining two blocks","having two wallets"],"answer":1,"source":"Bitcoin whitepaper, section 2"},{"id":"L2-013","level":"basic","q":"How does Bitcoin stop double spending?","choices":["by banks","by passwords","by lawyers","by proof of work and confirmations"],"answer":3,"source":"Bitcoin whitepaper, sections 4-5"},{"id":"L2-014","level":"basic","q":"What is a 51 percent attack?","choices":["one miner majority rewriting recent history","51 miners quitting","a 51 BTC theft","51 nodes updating"],"answer":0,"source":"bitcoin.org developer docs, mining"},{"id":"L2-015","level":"basic","q":"What is a private key?","choices":["your address","your wallet name","a secret number that signs your spends","a block password"],"answer":2,"source":"bitcoin.org developer docs, wallets"},{"id":"L2-016","level":"basic","q":"What is a public key?","choices":["a password you share","derived from the private key, used to make addresses","a miner's badge","a coin serial"],"answer":1,"source":"bitcoin.org developer docs, wallets"},{"id":"L2-017","level":"basic","q":"Which signature scheme did Bitcoin use first?","choices":["RSA","Schnorr","EdDSA","ECDSA"],"answer":3,"source":"bitcoin.org developer docs, transactions"},{"id":"L2-018","level":"basic","q":"Which signatures did Taproot add?","choices":["Schnorr","RSA","DSA","HMAC"],"answer":0,"source":"BIP-340"},{"id":"L2-019","level":"basic","q":"What is a multisig wallet?","choices":["many wallets","many coins","needing several keys to approve","many miners"],"answer":2,"source":"bitcoin.org developer docs, wallets"},{"id":"L2-020","level":"basic","q":"What is a hardware wallet?","choices":["a mining rig","a device keeping keys offline","a full node","a bank vault"],"answer":1,"source":"bitcoin.org, choose your wallet"},{"id":"L2-021","level":"basic","q":"What is a hot wallet?","choices":["a wallet connected to the internet","a stolen wallet","a hot computer","a new wallet"],"answer":0,"source":"bitcoin.org, securing your wallet"},{"id":"L2-022","level":"basic","q":"What is a cold wallet?","choices":["an empty wallet","a frozen account","a paper receipt","keys kept offline"],"answer":3,"source":"bitcoin.org, securing your wallet"},{"id":"L2-023","level":"basic","q":"What is an HD wallet?","choices":["a heavy wallet","one seed making many addresses","a shared wallet","a bank wallet"],"answer":1,"source":"BIP-32"},{"id":"L2-024","level":"basic","q":"Which standard gives derivation paths like m/84'/0'/0'?","choices":["BIP-21","BIP-39","BIP-44","BIP-141"],"answer":2,"source":"BIP-44"},{"id":"L2-025","level":"basic","q":"What is a watch-only wallet?","choices":["tracking a balance without the spending keys","watching miners","spying on blocks","a read-only block"],"answer":0,"source":"bitcoin.org developer docs, wallets"},{"id":"L2-026","level":"basic","q":"What is a BIP-21 payment request?","choices":["a block format","a payment link with address and amount","a signature type","a seed format"],"answer":1,"source":"BIP-21"},{"id":"L2-027","level":"basic","q":"What is invoice expiry on Lightning?","choices":["invoices last forever","invoices cost money","invoices need miners","an invoice is valid only for a set time"],"answer":3,"source":"BOLT 11"},{"id":"L2-028","level":"basic","q":"What is a channel on Lightning?","choices":["a chat room","a mining pool","locked funds shared by two parties","a bank account"],"answer":2,"source":"Lightning whitepaper"},{"id":"L2-029","level":"basic","q":"What is channel capacity?","choices":["the total sats locked in a channel","the number of users","the fee rate","the block size"],"answer":0,"source":"lnd docs, channel management"},{"id":"L2-030","level":"basic","q":"What is inbound liquidity?","choices":["money sent out","room to receive sats through a channel","miner income","wallet backup"],"answer":1,"source":"lnd docs, liquidity"},{"id":"L2-031","level":"basic","q":"What is a routing fee?","choices":["a mining fee","an exchange fee","a bank charge","a small fee paid to nodes forwarding a payment"],"answer":3,"source":"BOLT 7"}]}

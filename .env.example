# HostAfrica: add these in DirectAdmin > Setup Node.js App > (your app) > Environment variables.
# Local dev: copy to .env (never commit it).

NODE_ENV=production
SITE_URL=https://altradits.com
# Keep data outside public_html:
DATA_DIR=/home/altradit/altradits-data
# Send mail through the hosting server itself (no password needed):
EMAIL_TRANSPORT=sendmail
EMAIL_FROM=Altradits <hello@altradits.com>
OWNER_EMAIL=altradits@gmail.com

# Secrets: paste these yourself, never commit them.
ANTHROPIC_API_KEY=
# A long random string; it's the password for /admin.html
ADMIN_TOKEN=

# Lightning "scan to pay" (optional). Without these, QR invoices come from the
# Lightning address in data/catalog.js and you confirm payments yourself.
# With an LND node, invoices are created on your node and confirm automatically.
# LND_REST_URL=https://your-node.example.com:8080
# LND_INVOICE_MACAROON=   (hex of an invoice-only macaroon, see DEPLOY.md)
# LND_TLS_CERT=           (only for a self-signed node: PEM, or base64 of tls.cert)

# Optional
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=low
# SMTP_HOST= SMTP_PORT=465 SMTP_USER= SMTP_PASS=     (use a mailbox instead of sendmail)
# RESEND_API_KEY=                                     (or Resend)
# UPSTASH_REDIS_REST_URL= UPSTASH_REDIS_REST_TOKEN=   (only needed on Vercel)
# CRON_SECRET=                                        (only needed on Vercel)

# HostAfrica: add these in DirectAdmin > Setup Node.js App > (your app) > Environment variables.
# Local dev: copy to .env (never commit it).
NODE_ENV=production
SITE_URL=https://altradits.com
# Keep data outside public_html:
DATA_DIR=/home/altradit/altradits-data
# Send mail through the hosting server itself (no password needed):
EMAIL_TRANSPORT=sendmail
EMAIL_FROM=Altradits <hello@altradits.com>
OWNER_EMAIL=altradits@gmail.com
# Secrets: paste these yourself, never commit them.
# A long random string; it's the password for /admin
ADMIN_TOKEN=
# The Lightning node (LND). Without it, support invoices can't be made and the
# page shows the public Lightning address in lib/lightning.js instead.
# LND_REST_URL=https://your-node.example.com:8080
# LND_INVOICE_MACAROON=   (hex of an invoice-only macaroon, see DEPLOY.md)
# LND_READONLY_MACAROON=  (hex of readonly.macaroon: block height, sync and peers on the admin)
# LND_TLS_CERT=           (only for a self-signed node: PEM, or base64 of tls.cert)
# Ye₿ente wallets: see docs/yebente.md (YEBENTE_WALLETS, YEBENTE_LND_PAY_MACAROON, YEBENTE_TELEBIRR_*)
# Fiat deposits with M-Pesa (Safaricom Daraja): a prompt on the buyer's phone.
# MPESA_ENVIRONMENT=sandbox (or production)  MPESA_CONSUMER_KEY=  MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=  MPESA_PASSKEY=  YEBENTE_CALLBACK_SECRET=(long random path secret)
# YEBENTE_MPESA_BUY=on  (also: YEBENTE_BUY_MAX_KES=5000, YEBENTE_DAILY_BUY_KES=10000, YEBENTE_BUY_SPREAD_PCT=0)
# Fiat deposits with card or bank (Pesapal): the buyer pays on Pesapal's own page.
# PESAPAL_ENVIRONMENT=sandbox (or production)  PESAPAL_CONSUMER_KEY=  PESAPAL_CONSUMER_SECRET=
# PESAPAL_IPN_ID=(from Pesapal after registering the IPN address below)  PESAPAL_CALLBACK_SECRET=(long random path secret)
# YEBENTE_CARD_BUY=on  (IPN address: SITE_URL + /api/yebente/card/ipn/PESAPAL_CALLBACK_SECRET)
# Optional
# SMTP_HOST= SMTP_PORT=465 SMTP_USER= SMTP_PASS=     (use a mailbox instead of sendmail)
# RESEND_API_KEY=                                     (or Resend)
# BACKUP_KEY=                                         (encrypts the daily backup)

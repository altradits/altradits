# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/altradit/domains/altradits.com/public_html"
PassengerBaseURI "/"
PassengerNodejs "/home/altradit/nodevenv/domains/altradits.com/public_html/24/bin/node"
PassengerAppType node
PassengerStartupFile app.cjs
PassengerAppLogFile "/home/altradit/logs/passenger.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# (Kept in the repo: deploy/cron.sh runs `git reset --hard`, which would
# otherwise delete this block and every request would 404 at Apache.)
# On production Apache serves existing .html files directly, so clean page
# URLs need explicit aliases instead of relying on the local Node router.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # The agency moved to altradits/chouMi: its old pages send people to the nearest page here.
  RewriteRule ^cv(\.html)?/?$ /journey [R=301,L]
  RewriteRule ^(products|templates)(\.html)?/?$ /library [R=301,L]
  RewriteRule ^(va|hunt|join|team|portal|proposal|collect|hourly|wallet)(\.html)?/?$ / [R=301,L]
  RewriteRule ^(r|h)/[a-z0-9]{4,12}/?$ / [R=301,L]
  RewriteRule ^(bitcoin-setup|lightning)/?$ /bitcoin [R=301,L]
  RewriteRule ^(bio|captions|schedule|graphics|reel|newsletter|blog|product-copy|try|data-entry|pdf-sheet|sheet-cleanup|slides|sop|inbox-cleanup|meeting-notes|invoices|receipts|job-post|cv-screen|booking|trip|subscriptions|rsvp|leads|cold-email|reply-templates|faq|reviews|listings|competitors|suppliers|email-signature|site-fix|google-profile|business-email|automation|transcribe|translate|social-management|content-writing|short-video|inbox-calendar|data-docs|bookkeeping-prep|project-coordination|hr-recruiting|travel-life|executive-assist|events|customer-support|lead-generation|ecommerce-ops|host-assist|research|website|store-payments|automation-ai|translation|lite|core|partner)/?$ / [R=301,L]
  RewriteRule ^(admin|bitcoin|donate|bitcoin-core|library|players|friends|plan|tracker|journey)/?$ $1.html [L]

  # Ye₿ente: the built app lives in yebente/app.
  RewriteRule ^yebente/?$ yebente/app/index.html [L]
  RewriteRule ^yebente/index\.html$ yebente/app/index.html [L]
  RewriteRule ^yebente/((assets|fonts|icons)/[A-Za-z0-9._-]+)$ yebente/app/$1 [L]
  RewriteRule ^yebente/manifest\.webmanifest$ yebente/app/manifest.webmanifest [L]
  # kTown: the app at /ktown, the terms at /ktown/terms, the pay page at /k/<id> (query strings pass through).
  RewriteRule ^ktown/?$ ktown/index.html [L]
  RewriteRule ^ktown/terms/?$ ktown/terms.html [L]
  RewriteRule ^k/([A-Za-z0-9_-]+)/?$ ktown/pay.html [L]
</IfModule>

# Pages are checked on every visit, so an update shows at once (an unchanged
# page still loads from cache). Without this, browsers guess and keep old pages for hours.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Server code and project files are never web content. The Node router only
# serves whitelisted paths, but Apache answers directly for existing files.
<FilesMatch "^(\.env(\..*)?|server\.mjs|app\.cjs|README\.md|CLAUDE\.md|AGENTS\.md|DEPLOY\.md|LICENSE|package(-lock)?\.json|vercel\.json|\.gitignore|\.deploy\.lock|SECURITY\.md|CONTRIBUTING\.md|CODE_OF_CONDUCT\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Git metadata and local runtime state are never web content.
RedirectMatch 404 ^/\.git(?:/|$)
RedirectMatch 404 ^/\.data(?:/|$)
RedirectMatch 404 ^/\.github(?:/|$)
RedirectMatch 404 ^/\.claude(?:/|$)

# Browser security for the pages Apache serves directly (Node adds the same to
# its own responses): HTTPS only once visited, no MIME sniffing, no framing.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

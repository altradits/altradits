{
  "openapi": "3.1.0",
  "info": {
    "title": "Altradits Developer API",
    "version": "1.1.0",
    "summary": "Power your app with Altradits infrastructure. Your customers pay straight to your own Lightning address or node. Altradits never holds their money.",
    "description": "Non-custodial Lightning infrastructure for developers. Register your own Lightning address, create invoices to it through this API, get settlement verification and webhooks. Customer payments go straight to your address. Altradits charges you 0.5% of settled volume, prepaid in sats to Stanley's node as a fee balance. The sandbox is free. Authentication: Authorization: Bearer <session or API key>. Every reply carries a requestId. Every error carries a stable code and a human sentence: { ok: false, requestId, code, error }.",
    "contact": { "name": "Altradits", "url": "https://altradits.com/developer" },
    "license": { "name": "MIT", "url": "https://github.com/altradits/altradits/blob/main/LICENSE" }
  },
  "servers": [{ "url": "https://altradits.com/api/dev/v1", "description": "Live" }],
  "security": [{ "bearer": [] }],
  "tags": [
    { "name": "health", "description": "Switch status. Always answers." },
    { "name": "accounts", "description": "Signup and sign-in with email codes." },
    { "name": "keys", "description": "API keys. Shown once, stored hashed, scoped." },
    { "name": "destinations", "description": "Your own Lightning addresses, with ownership proof." },
    { "name": "invoices", "description": "Invoices to your destinations, fetched from your address and checked. Needs an API key." },
    { "name": "webhooks", "description": "Signed POSTs when an invoice settles. Needs a key with the webhooks scope, or a session." }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "API status",
        "description": "Always answers, even when the API is off. api is on when DEVAPI=on, sandbox is on when DEVAPI_SANDBOX=on.",
        "security": [],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/accounts/request-code": {
      "post": {
        "tags": ["accounts"],
        "summary": "Request a signup code",
        "description": "Emails a one-time 8-digit code. Works once, for 10 minutes. At most 5 codes an hour per address. Never reveals whether an address is registered.",
        "security": [],
        "operationId": "requestCode",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestCode" } } } },
        "responses": {
          "200": { "description": "Code sent.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sent" } } } },
          "422": { "description": "Likely typo in the email domain.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Too many codes.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "501": { "description": "The API is not open.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/accounts/verify-code": {
      "post": {
        "tags": ["accounts"],
        "summary": "Verify the code",
        "description": "Verifies the email and creates the account on first use, or signs an existing account back in. Returns a dashboard session token, good for 30 days. Wrong guesses are limited per address.",
        "security": [],
        "operationId": "verifyCode",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyCode" } } } },
        "responses": {
          "200": { "description": "Verified.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "400": { "description": "Wrong or expired code.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Too many wrong tries.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/accounts/me": {
      "get": {
        "tags": ["accounts"],
        "summary": "My account",
        "description": "The signed-in account. Needs a dashboard session token.",
        "operationId": "me",
        "responses": {
          "200": { "description": "The account.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } },
          "401": { "description": "Sign in again.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/accounts/sign-out": {
      "post": {
        "tags": ["accounts"],
        "summary": "Sign out",
        "description": "Ends this dashboard session at once.",
        "operationId": "signOut",
        "responses": {
          "200": { "description": "Signed out.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignedOut" } } } }
        }
      }
    },
    "/keys": {
      "get": {
        "tags": ["keys"],
        "summary": "List keys",
        "description": "Every key on the account, newest first. Only public halves: secrets never leave the store.",
        "operationId": "listKeys",
        "responses": {
          "200": { "description": "The keys.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KeyList" } } } }
        }
      },
      "post": {
        "tags": ["keys"],
        "summary": "Create a key",
        "description": "Creates an API key. Live keys start with ak_live_, sandbox keys with ak_test_. The secret is shown once and never again. Scopes default to all three. A test key can never touch mainnet, and a live key never works while the API is off.",
        "operationId": "createKey",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateKey" } } } },
        "responses": {
          "201": { "description": "The key, shown once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KeySecret" } } } },
          "400": { "description": "Unknown scope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "501": { "description": "That environment is not switched on.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/keys/{id}/rotate": {
      "post": {
        "tags": ["keys"],
        "summary": "Rotate a key",
        "description": "Revokes the key and creates its replacement with the same name, scopes and environment. The new secret is shown once.",
        "operationId": "rotateKey",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "201": { "description": "The replacement key, shown once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KeySecret" } } } },
          "404": { "description": "Unknown key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "410": { "description": "Already revoked.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/keys/{id}/revoke": {
      "post": {
        "tags": ["keys"],
        "summary": "Revoke a key",
        "description": "Revokes the key at once. The record is kept, never deleted.",
        "operationId": "revokeKey",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Revoked.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Revoked" } } } },
          "404": { "description": "Unknown key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/destinations": {
      "get": {
        "tags": ["destinations"],
        "summary": "List destinations",
        "description": "Every registered address on the account.",
        "operationId": "listDestinations",
        "responses": {
          "200": { "description": "The destinations.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DestinationList" } } } }
        }
      },
      "post": {
        "tags": ["destinations"],
        "summary": "Register a destination",
        "description": "Registers your own Lightning address and starts the ownership proof: the address must resolve over LNURL-pay and name itself in its metadata, and you pay a 1-sat challenge invoice from the wallet behind it within an hour, then call prove. What the proof shows: you control a funded Lightning wallet, and the address resolves to itself. Lightning payments carry no sender identity, so it does not cryptographically prove the wallet owns the address. Your customers' payments go straight to this address. Altradits never holds them.",
        "operationId": "registerDestination",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterDestination" } } } },
        "responses": {
          "201": { "description": "Registered, with the challenge invoice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DestinationChallenge" } } } },
          "409": { "description": "Already registered.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "description": "The address does not name itself.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "502": { "description": "The address is not reachable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Stanley's node is offline, so no challenge can be issued.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/destinations/{id}/prove": {
      "post": {
        "tags": ["destinations"],
        "summary": "Prove ownership",
        "description": "Checks the 1-sat challenge invoice is settled and the address still resolves to itself, then marks the destination verified.",
        "operationId": "proveDestination",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Verified.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Destination" } } } },
          "404": { "description": "Unknown destination.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "The challenge is not paid yet.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "410": { "description": "The challenge expired. Register again.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/invoices": {
      "get": {
        "tags": ["invoices"],
        "summary": "List invoices",
        "description": "Your invoices, newest first. A key sees only its own environment. Cursor pagination: limit (1 to 200, default 50), then cursor=nextCursor.",
        "operationId": "listInvoices",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The page.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceList" } } } }
        }
      },
      "post": {
        "tags": ["invoices"],
        "summary": "Create an invoice",
        "description": "Fetches a BOLT11 invoice from your verified destination for exactly the amount, checks the amount and the description hash, and tracks it. The invoice is your destination's own reply, passed through unchanged: your customer pays straight to your address. At most 100,000,000 sats per invoice. Fiat is converted at the live rate at creation and the rate is recorded. Frozen during a security lockdown (503 lockdown_freeze). Send Idempotency-Key to retry safely: the same key replays the first reply for 24 hours.",
        "operationId": "createInvoice",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" }, "description": "A unique key for this creation. Replays the first reply for 24 hours." }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateInvoice" } } } },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } } },
          "200": { "description": "Replayed idempotent reply (deduplicated: true).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } } },
          "404": { "description": "Unknown destination.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Destination not verified.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "description": "Bad amount, out-of-range amount, idempotency conflict, or the destination renamed itself.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "502": { "description": "The destination is unreachable or returned a bad invoice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Lockdown freeze, or the price feed is down.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/invoices/{id}": {
      "get": {
        "tags": ["invoices"],
        "summary": "Invoice status",
        "description": "The invoice, with a live settlement check when the destination supports LUD-21 verify. Without verify support the invoice stays pending here and the reply says so plainly: confirm in your own wallet.",
        "operationId": "getInvoice",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "The invoice and its settlement state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceStatus" } } } },
          "404": { "description": "Unknown invoice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "502": { "description": "The destination didn't answer the settlement check.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/verify/{hash}": {
      "get": {
        "tags": ["invoices"],
        "summary": "Verify by payment hash",
        "description": "Settlement state for one of your invoices by its payment hash (64 hex characters). Same live check as invoice status.",
        "operationId": "verifyByHash",
        "parameters": [{ "name": "hash", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }],
        "responses": {
          "200": { "description": "The invoice and its settlement state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceStatus" } } } },
          "404": { "description": "Unknown invoice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/webhooks": {
      "get": {
        "tags": ["webhooks"],
        "summary": "List webhook endpoints",
        "description": "Every endpoint on the account. A key sees only its own environment; a session sees all.",
        "operationId": "listWebhooks",
        "responses": {
          "200": { "description": "The endpoints.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookList" } } } }
        }
      },
      "post": {
        "tags": ["webhooks"],
        "summary": "Register a webhook endpoint",
        "description": "Registers an https URL for invoice.settled events. The secret is shown once and never again. Deliveries POST JSON { event, invoice, deliveredAt } with X-Dev-Signature: t=<unix seconds>,v1=<hex> where v1 is HMAC-SHA256(secret, '<t>.<raw body>'). Check the timestamp is within 5 minutes and compare in constant time. Failures retry after 1m, 5m, 30m, 2h and 12h, then the delivery is marked dead. Endpoints are never deleted, only disabled.",
        "operationId": "registerWebhook",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterWebhook" } } } },
        "responses": {
          "201": { "description": "Registered, with the secret shown once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSecret" } } } },
          "400": { "description": "Bad URL or events.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/webhooks/{id}/disable": {
      "post": {
        "tags": ["webhooks"],
        "summary": "Disable an endpoint",
        "description": "Stops new deliveries at once. The endpoint and its delivery log are kept, never deleted.",
        "operationId": "disableWebhook",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Disabled.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Webhook" } } } },
          "404": { "description": "Unknown webhook.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/webhooks/{id}/deliveries": {
      "get": {
        "tags": ["webhooks"],
        "summary": "Delivery log",
        "description": "Every delivery to the endpoint, newest first, with each attempt. Cursor pagination like invoices.",
        "operationId": "listDeliveries",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The page.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryList" } } } },
          "404": { "description": "Unknown webhook.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "description": "A dashboard session token, or an API key (ak_live_... or ak_test_...). Keys are told apart from sessions by their prefix." }
    },
    "schemas": {
      "Health": { "type": "object", "required": ["ok", "requestId", "version", "api", "sandbox"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "version": { "const": "v1" }, "api": { "enum": ["on", "off"] }, "sandbox": { "enum": ["on", "off"] } } },
      "Error": { "type": "object", "required": ["ok", "requestId", "code", "error"], "properties": { "ok": { "const": false }, "requestId": { "type": "string" }, "code": { "type": "string", "description": "Stable machine code, e.g. invalid_key, bad_code, challenge_unpaid, insufficient_credits, lockdown_freeze." }, "error": { "type": "string", "description": "A human sentence." } } },
      "Sent": { "type": "object", "required": ["ok", "requestId", "sent"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "sent": { "const": true } } },
      "SignedOut": { "type": "object", "required": ["ok", "requestId", "signedOut"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "signedOut": { "const": true } } },
      "Revoked": { "type": "object", "required": ["ok", "requestId", "revoked"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "revoked": { "const": true } } },
      "RequestCode": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" }, "confirmTypo": { "type": "boolean", "description": "Set true to accept the address as typed after a 422 typo hint." } } },
      "VerifyCode": { "type": "object", "required": ["email", "code"], "properties": { "email": { "type": "string", "format": "email" }, "code": { "type": "string", "description": "The 8-digit code from the email." } } },
      "Account": { "type": "object", "required": ["ok", "requestId", "account"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "account": { "$ref": "#/components/schemas/AccountObject" } } },
      "AccountObject": { "type": "object", "required": ["id", "email", "createdAt", "verifiedAt", "suspended"], "properties": { "id": { "type": "string" }, "email": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "verifiedAt": { "type": "string", "format": "date-time" }, "suspended": { "type": "boolean" } } },
      "Session": { "type": "object", "required": ["ok", "requestId", "account", "session"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "account": { "$ref": "#/components/schemas/AccountObject" }, "session": { "type": "string", "description": "Dashboard session token, good for 30 days." } } },
      "CreateKey": { "type": "object", "properties": { "name": { "type": "string", "maxLength": 60 }, "scopes": { "type": "array", "items": { "enum": ["invoices:create", "invoices:read", "webhooks"] }, "description": "Defaults to all three." }, "sandbox": { "type": "boolean", "description": "True for a test key (ak_test_...). Defaults to false." } } },
      "KeyObject": { "type": "object", "required": ["id", "prefix", "name", "scopes", "sandbox", "createdAt", "revokedAt", "lastUsedAt"], "properties": { "id": { "type": "string" }, "prefix": { "type": "string", "description": "First characters, for telling keys apart." }, "name": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string" } }, "sandbox": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" }, "revokedAt": { "type": ["string", "null"], "format": "date-time" }, "lastUsedAt": { "type": ["string", "null"], "format": "date-time" } } },
      "KeySecret": { "type": "object", "required": ["ok", "requestId", "key", "id", "prefix", "name", "scopes", "sandbox", "createdAt"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "key": { "type": "string", "description": "The full secret. Shown once, never again." }, "id": { "type": "string" }, "prefix": { "type": "string" }, "name": { "type": "string" }, "scopes": { "type": "array", "items": { "type": "string" } }, "sandbox": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" }, "note": { "type": "string" } } },
      "KeyList": { "type": "object", "required": ["ok", "requestId", "keys"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "keys": { "type": "array", "items": { "$ref": "#/components/schemas/KeyObject" } } } },
      "RegisterDestination": { "type": "object", "required": ["address"], "properties": { "address": { "type": "string", "description": "Your own Lightning address, like name@wallet.com." }, "sandbox": { "type": "boolean", "description": "True to register it for the sandbox. Defaults to false." } } },
      "DestinationObject": { "type": "object", "required": ["id", "address", "sandbox", "verified", "verifiedAt", "proof", "createdAt"], "properties": { "id": { "type": "string" }, "address": { "type": "string" }, "sandbox": { "type": "boolean" }, "verified": { "type": "boolean" }, "verifiedAt": { "type": ["string", "null"], "format": "date-time" }, "proof": { "type": ["string", "null"], "description": "How ownership was proven, once verified." }, "createdAt": { "type": "string", "format": "date-time" } } },
      "Destination": { "type": "object", "required": ["ok", "requestId", "destination"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "destination": { "$ref": "#/components/schemas/DestinationObject" } } },
      "DestinationList": { "type": "object", "required": ["ok", "requestId", "destinations"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "destinations": { "type": "array", "items": { "$ref": "#/components/schemas/DestinationObject" } } } },
      "DestinationChallenge": { "type": "object", "required": ["ok", "requestId", "destination", "challenge"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "destination": { "$ref": "#/components/schemas/DestinationObject" }, "challenge": { "type": "object", "required": ["bolt11", "expiresAt", "note"], "properties": { "bolt11": { "type": "string", "description": "The 1-sat challenge invoice. Pay it from the wallet behind the address." }, "expiresAt": { "type": "string", "format": "date-time" }, "note": { "type": "string" } } } } },
      "CreateInvoice": { "type": "object", "required": ["destinationId"], "properties": { "destinationId": { "type": "string", "description": "A verified destination on your account, in the key's environment." }, "sats": { "type": "integer", "minimum": 1, "maximum": 100000000, "description": "Whole sats. Give sats or fiat, not both." }, "fiat": { "type": "object", "required": ["amount", "currency"], "properties": { "amount": { "type": "number", "exclusiveMinimum": 0 }, "currency": { "enum": ["USD", "KES"] } }, "description": "Converted at the live rate at creation; the rate is recorded on the invoice." }, "memo": { "type": "string", "maxLength": 200, "description": "Passed as the LNURL comment when the destination allows one." } } },
      "InvoiceObject": { "type": "object", "required": ["id", "destinationId", "address", "sandbox", "sats", "fiat", "memo", "bolt11", "paymentHash", "status", "verifySupported", "preimage", "createdAt", "settledAt"], "properties": { "id": { "type": "string" }, "destinationId": { "type": "string" }, "address": { "type": "string", "description": "Your destination. The payment goes straight there." }, "sandbox": { "type": "boolean" }, "sats": { "type": "integer" }, "fiat": { "type": ["object", "null"], "properties": { "amount": { "type": "number" }, "currency": { "type": "string" }, "btcRate": { "type": "number", "description": "Fiat per BTC at creation." } } }, "memo": { "type": ["string", "null"] }, "bolt11": { "type": "string", "description": "Your destination's own invoice, passed through unchanged." }, "paymentHash": { "type": "string" }, "status": { "enum": ["pending", "settled"] }, "verifySupported": { "type": "boolean", "description": "False when the destination answers no LUD-21 verify URL: the invoice then stays pending here." }, "preimage": { "type": ["string", "null"], "description": "Proof of payment, when the destination reports it." }, "createdAt": { "type": "string", "format": "date-time" }, "settledAt": { "type": ["string", "null"], "format": "date-time" } } },
      "Invoice": { "type": "object", "required": ["ok", "requestId", "invoice"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "invoice": { "$ref": "#/components/schemas/InvoiceObject" }, "deduplicated": { "type": "boolean", "description": "True when an Idempotency-Key replayed the first reply." } } },
      "InvoiceStatus": { "type": "object", "required": ["ok", "requestId", "invoice", "verifySupported"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "invoice": { "$ref": "#/components/schemas/InvoiceObject" }, "verifySupported": { "type": "boolean" }, "note": { "type": "string", "description": "Present when the destination doesn't report settlement." } } },
      "InvoiceList": { "type": "object", "required": ["ok", "requestId", "invoices", "nextCursor"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "invoices": { "type": "array", "items": { "$ref": "#/components/schemas/InvoiceObject" } }, "nextCursor": { "type": ["string", "null"] } } },
      "RegisterWebhook": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "description": "An https URL on a public host." }, "events": { "type": "array", "items": { "enum": ["invoice.settled"] }, "description": "Defaults to invoice.settled." }, "sandbox": { "type": "boolean", "description": "True to fire only for sandbox invoices. Defaults to false." } } },
      "WebhookObject": { "type": "object", "required": ["id", "url", "sandbox", "events", "enabled", "createdAt"], "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "sandbox": { "type": "boolean" }, "events": { "type": "array", "items": { "type": "string" } }, "enabled": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" } } },
      "Webhook": { "type": "object", "required": ["ok", "requestId", "webhook"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "webhook": { "$ref": "#/components/schemas/WebhookObject" } } },
      "WebhookSecret": { "type": "object", "required": ["ok", "requestId", "webhook", "secret"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "webhook": { "$ref": "#/components/schemas/WebhookObject" }, "secret": { "type": "string", "description": "Signs every delivery. Shown once, never again." }, "note": { "type": "string" } } },
      "WebhookList": { "type": "object", "required": ["ok", "requestId", "webhooks"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "webhooks": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookObject" } } } },
      "DeliveryObject": { "type": "object", "required": ["id", "webhookId", "invoiceId", "event", "createdAt", "attempts", "done", "dead", "nextAt"], "properties": { "id": { "type": "string" }, "webhookId": { "type": "string" }, "invoiceId": { "type": "string" }, "event": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "attempts": { "type": "array", "items": { "type": "object", "properties": { "at": { "type": "string", "format": "date-time" }, "ok": { "type": "boolean" }, "code": { "type": "integer" } } } }, "done": { "type": "boolean" }, "dead": { "type": "boolean", "description": "True when every retry failed." }, "nextAt": { "type": ["string", "null"], "format": "date-time" } } },
      "DeliveryList": { "type": "object", "required": ["ok", "requestId", "deliveries", "nextCursor"], "properties": { "ok": { "const": true }, "requestId": { "type": "string" }, "deliveries": { "type": "array", "items": { "$ref": "#/components/schemas/DeliveryObject" } }, "nextCursor": { "type": ["string", "null"] } } }
    }
  }
}
